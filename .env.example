# ==============================================================================
# Modern Rails 8 Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker Registry / Kamal Deployment
# ------------------------------------------------------------------------------
DOCKER_USERNAME="oharato"
KAMAL_REGISTRY_PASSWORD="dckr_pat_xxxx"
KAMAL_REGISTRY_SERVER="us-central1-docker.pkg.dev/modern-rails-xxxx/modern-rails-repo"

# Basic Authentication (production environment)
BASIC_AUTH_USER="modern-rails"
BASIC_AUTH_PASSWORD="your-secure-password"

# GCP Service Account Key for Artifact Registry & Kamal
GCP_SA_KEY_BASE64="ey..."

# ------------------------------------------------------------------------------
# 2. GCP Infrastructure Settings (Pulumi)
# ------------------------------------------------------------------------------
GCP_PROJECT="modern-rails-1786791154"
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"

# ------------------------------------------------------------------------------
# 3. Cloudflare CDN & Edge HTTPS Settings (Pulumi)
# ------------------------------------------------------------------------------
# Cloudflare API Token (Permissions: Zone.DNS:Edit, Zone.Zone Settings:Edit)
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# Cloudflare Zone ID (found in Cloudflare dashboard domain overview)
CLOUDFLARE_ZONE_ID="your_cloudflare_zone_id_here"

# Target domain or subdomain ("@" for apex domain, "app" for app.example.com)
CLOUDFLARE_DOMAIN="@"
DOMAIN="example.com"
