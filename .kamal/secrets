# Kamal Secrets definition
# Automatically extracted from encrypted Rails credentials using RAILS_MASTER_KEY!

RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || echo "$RAILS_MASTER_KEY")

# Extract secrets from Rails encrypted credentials if master key is present
GCP_SA_KEY_BASE64=$(bin/rails runner 'puts Rails.application.credentials.gcp_sa_key_base64' 2>/dev/null || echo "$GCP_SA_KEY_BASE64")
POSTGRES_PASSWORD=$(bin/rails runner 'puts Rails.application.credentials.postgres_password' 2>/dev/null || echo "modern_rails_production_password_2026")
MODERN_RAILS_DATABASE_PASSWORD=$POSTGRES_PASSWORD
BASIC_AUTH_USER=$(bin/rails runner 'puts Rails.application.credentials.basic_auth_user' 2>/dev/null || echo "admin")
BASIC_AUTH_PASSWORD=$(bin/rails runner 'puts Rails.application.credentials.basic_auth_password' 2>/dev/null || echo "password123")
