# Kamal Secrets definition
# Automatically extracted from encrypted Rails credentials using RAILS_MASTER_KEY or ENV

RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || echo "$RAILS_MASTER_KEY")

if [ -n "$RAILS_MASTER_KEY" ]; then
  eval "$(ruby - << 'EOF'
require "active_support/encrypted_configuration"
config = ActiveSupport::EncryptedConfiguration.new(
  config_path: Pathname.new("config/credentials.yml.enc"),
  key_path: Pathname.new("config/master.key"),
  env_key: "RAILS_MASTER_KEY",
  raise_if_missing_key: false
)
creds = config.config rescue {}
val = ->(v) { (v && !v.to_s.strip.empty?) ? v.to_s.strip : nil }
gcp = val[ENV["GCP_SA_KEY_BASE64"]] || creds[:gcp_sa_key_base64]
puts "GCP_SA_KEY_BASE64=\"#{gcp}\""
pw = val[ENV["POSTGRES_PASSWORD"]] || val[ENV["MODERN_RAILS_DATABASE_PASSWORD"]] || creds[:postgres_password] || creds[:modern_rails_database_password]
puts "POSTGRES_PASSWORD=\"#{pw}\""
puts "MODERN_RAILS_DATABASE_PASSWORD=\"#{pw}\""
user = val[ENV["BASIC_AUTH_USER"]] || creds[:basic_auth_user]
puts "BASIC_AUTH_USER=\"#{user}\""
basic_pw = val[ENV["BASIC_AUTH_PASSWORD"]] || creds[:basic_auth_password]
puts "BASIC_AUTH_PASSWORD=\"#{basic_pw}\""
EOF
)"
else
  GCP_SA_KEY_BASE64=$(echo "$GCP_SA_KEY_BASE64")
  POSTGRES_PASSWORD=$(echo "$POSTGRES_PASSWORD")
  MODERN_RAILS_DATABASE_PASSWORD=$(echo "${MODERN_RAILS_DATABASE_PASSWORD:-$POSTGRES_PASSWORD}")
  BASIC_AUTH_USER=$(echo "$BASIC_AUTH_USER")
  BASIC_AUTH_PASSWORD=$(echo "$BASIC_AUTH_PASSWORD")
fi
