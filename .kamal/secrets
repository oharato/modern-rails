# Secrets defined here are injected by Kamal.
# Defaults are safely fallback-configured so manual entry is minimal.

# GCP Artifact Registry Key (automatically provided from ENV or Pulumi)
GCP_SA_KEY_BASE64=$GCP_SA_KEY_BASE64

# Rails Master Key
RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || echo "$RAILS_MASTER_KEY")

# Database Password (synchronized fallback)
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-${MODERN_RAILS_DATABASE_PASSWORD:-modern_rails_production_password_2026}}
MODERN_RAILS_DATABASE_PASSWORD=${MODERN_RAILS_DATABASE_PASSWORD:-$POSTGRES_PASSWORD}

# Basic Auth Protection
BASIC_AUTH_USER=${BASIC_AUTH_USER:-admin}
BASIC_AUTH_PASSWORD=${BASIC_AUTH_PASSWORD:-password123}
