# Kamal Secrets definition
# Automatically extracted from encrypted Rails credentials using RAILS_MASTER_KEY or ENV

RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || echo "$RAILS_MASTER_KEY")
GCP_SA_KEY_BASE64=$(ruby -e 'require "active_support/encrypted_configuration"; c = ActiveSupport::EncryptedConfiguration.new(config_path: Pathname.new("config/credentials.yml.enc"), key_path: Pathname.new("config/master.key"), env_key: "RAILS_MASTER_KEY", raise_if_missing_key: false); puts c.config&.dig(:gcp_sa_key_base64)' 2>/dev/null || echo "$GCP_SA_KEY_BASE64")
POSTGRES_PASSWORD=$(ruby -e 'require "active_support/encrypted_configuration"; c = ActiveSupport::EncryptedConfiguration.new(config_path: Pathname.new("config/credentials.yml.enc"), key_path: Pathname.new("config/master.key"), env_key: "RAILS_MASTER_KEY", raise_if_missing_key: false); puts (c.config&.dig(:postgres_password) || c.config&.dig(:modern_rails_database_password))' 2>/dev/null || echo "$POSTGRES_PASSWORD")
MODERN_RAILS_DATABASE_PASSWORD=$POSTGRES_PASSWORD
BASIC_AUTH_USER=$(ruby -e 'require "active_support/encrypted_configuration"; c = ActiveSupport::EncryptedConfiguration.new(config_path: Pathname.new("config/credentials.yml.enc"), key_path: Pathname.new("config/master.key"), env_key: "RAILS_MASTER_KEY", raise_if_missing_key: false); puts c.config&.dig(:basic_auth_user)' 2>/dev/null || echo "$BASIC_AUTH_USER")
BASIC_AUTH_PASSWORD=$(ruby -e 'require "active_support/encrypted_configuration"; c = ActiveSupport::EncryptedConfiguration.new(config_path: Pathname.new("config/credentials.yml.enc"), key_path: Pathname.new("config/master.key"), env_key: "RAILS_MASTER_KEY", raise_if_missing_key: false); puts c.config&.dig(:basic_auth_password)' 2>/dev/null || echo "$BASIC_AUTH_PASSWORD")
