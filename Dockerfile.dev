# syntax=docker/dockerfile:1
ARG RUBY_VERSION=4.0.6
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# Install base packages (matches production runtime + development build tools)
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      curl \
      git \
      libjemalloc2 \
      libvips42 \
      libyaml-dev \
      pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Set development environment
ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_BIN="/usr/local/bundle/bin" \
    PATH="/usr/local/bundle/bin:${PATH}"

# Install gems with BuildKit cache
COPY Gemfile Gemfile.lock ./
RUN --mount=type=cache,target=/root/.bundle/cache \
    bundle install

# Copy application code
COPY . .

# Run as non-root user matching host UID (1000) for security & file permissions
RUN groupadd --system --gid 1000 rails 2>/dev/null || true && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash 2>/dev/null || true && \
    chown -R 1000:1000 /rails /usr/local/bundle 2>/dev/null || true

USER 1000:1000

ENTRYPOINT ["/rails/bin/docker-entrypoint"]

# Expose server port
EXPOSE 3000

# Default command
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
