#!/usr/bin/env bash
set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Load .env if present
if [ -f "$PROJECT_ROOT/.env" ]; then
  # export variables from .env
  set -a
  source "$PROJECT_ROOT/.env"
  set +a
fi

# Load .kamal/secrets if present
if [ -f "$PROJECT_ROOT/.kamal/secrets" ]; then
  set -a
  source "$PROJECT_ROOT/.kamal/secrets" 2>/dev/null || true
  set +a
fi

# If native kamal is installed on host, use it
if command -v kamal >/dev/null 2>&1; then
  exec kamal "$@"
fi

# Otherwise, run Kamal via Docker container sharing host Docker socket & SSH keys
SSH_DIR="$HOME/.ssh"
DOCKER_SOCK="/var/run/docker.sock"

docker run --rm -it \
  --network host \
  -v "$DOCKER_SOCK:$DOCKER_SOCK" \
  -v "$SSH_DIR:/root/.ssh:ro" \
  -v "$PROJECT_ROOT:/workdir" \
  -w /workdir \
  -e KAMAL_REGISTRY_PASSWORD \
  -e DOCKER_USERNAME \
  -e RAILS_MASTER_KEY \
  -e BASIC_AUTH_USER \
  -e BASIC_AUTH_PASSWORD \
  -e GCP_SA_KEY_BASE64 \
  -e KAMAL_REGISTRY_SERVER \
  ghcr.io/basecamp/kamal:latest "$@"
