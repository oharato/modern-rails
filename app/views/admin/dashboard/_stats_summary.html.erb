<div id="dashboard_stats" class="grid grid-cols-2 lg:grid-cols-4 gap-4">
  <div class="p-5 bg-slate-900 rounded-2xl border border-slate-800 space-y-1">
    <div class="text-xs font-semibold text-slate-400">総売上 (累計)</div>
    <div class="text-2xl font-black text-white"><%= number_to_currency(Order.where(status: %w[paid shipped]).sum(:total_amount), unit: "¥", precision: 0) %></div>
    <div class="text-[11px] text-slate-500">決済完了・発送済</div>
  </div>
  <div class="p-5 bg-slate-900 rounded-2xl border border-slate-800 space-y-1">
    <div class="text-xs font-semibold text-slate-400">総注文件数</div>
    <div class="text-2xl font-black text-indigo-400"><%= Order.where(status: %w[paid shipped]).count %> <span class="text-sm font-normal text-slate-400">件</span></div>
    <div class="text-[11px] text-slate-500">全期間</div>
  </div>
  <div class="p-5 bg-slate-900 rounded-2xl border border-slate-800 space-y-1">
    <div class="text-xs font-semibold text-slate-400">本日の売上</div>
    <div class="text-2xl font-black text-emerald-400"><%= number_to_currency(Order.where(created_at: Date.current.all_day, status: %w[paid shipped]).sum(:total_amount), unit: "¥", precision: 0) %></div>
    <div class="text-[11px] text-slate-500"><%= Date.current.strftime("%m/%d") %></div>
  </div>
  <div class="p-5 bg-slate-900 rounded-2xl border border-slate-800 space-y-1">
    <div class="text-xs font-semibold text-slate-400">本日の注文数</div>
    <div class="text-2xl font-black text-amber-400"><%= Order.where(created_at: Date.current.all_day, status: %w[paid shipped]).count %> <span class="text-sm font-normal text-slate-400">件</span></div>
    <div class="text-[11px] text-slate-500">リアルタイム同期</div>
  </div>
</div>
