<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-black text-white tracking-tight">注文詳細: <%= @order.order_number %></h1>
    <%= link_to "&larr; 注文一覧へ戻る".html_safe, admin_orders_path, class: "text-xs font-bold text-slate-400 hover:text-white" %>
  </div>

  <div class="bg-slate-900 rounded-3xl border border-slate-800 p-6 space-y-4">
    <div class="grid grid-cols-2 gap-4 text-xs border-b border-slate-800 pb-4">
      <div>
        <span class="text-slate-500">注文者:</span>
        <div class="font-bold text-white mt-0.5"><%= @order.user.name.presence || @order.user.email_address %> (<%= @order.user.email_address %>)</div>
      </div>
      <div>
        <span class="text-slate-500">ステータス:</span>
        <div class="font-bold text-emerald-400 mt-0.5"><%= @order.status.upcase %></div>
      </div>
    </div>

    <h3 class="font-bold text-sm text-white pt-2">注文明細</h3>
    <div class="divide-y divide-slate-800">
      <% @order.order_items.each do |item| %>
        <div class="py-2 flex justify-between items-center text-xs">
          <span class="text-slate-300"><%= item.product&.name %> &times; <%= item.quantity %></span>
          <span class="font-bold text-white"><%= number_to_currency(item.subtotal, unit: "¥", precision: 0) %></span>
        </div>
      <% end %>
    </div>

    <div class="pt-4 border-t border-slate-800 flex justify-between items-baseline">
      <span class="text-sm font-bold text-slate-400">合計金額</span>
      <span class="text-2xl font-black text-amber-400"><%= number_to_currency(@order.total_amount, unit: "¥", precision: 0) %></span>
    </div>

    <div class="pt-4 border-t border-slate-800 flex justify-end space-x-3">
      <%= link_to receipt_order_path(@order), target: "_blank", class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition" do %>
        📄 領収書PDF確認
      <% end %>
    </div>
  </div>
</div>
