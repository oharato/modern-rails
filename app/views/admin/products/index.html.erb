<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">商品管理</h1>
      <p class="text-xs text-slate-400 mt-1">登録商品一覧・在庫編集・公開/非公開設定</p>
    </div>
    <%= link_to new_admin_product_path, class: "inline-flex items-center px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shadow-md transition" do %>
      + 新規商品登録
    <% end %>
  </div>

  <div class="bg-slate-900 rounded-3xl border border-slate-800 overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-slate-950/60 text-[11px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-800">
          <tr>
            <th class="py-3 px-4">商品名</th>
            <th class="py-3 px-4">カテゴリ</th>
            <th class="py-3 px-4">価格</th>
            <th class="py-3 px-4">在庫数</th>
            <th class="py-3 px-4">公開状態</th>
            <th class="py-3 px-4 text-right">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% @products.each do |product| %>
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-3 px-4">
                <div class="font-bold text-sm text-white"><%= product.name %></div>
                <div class="text-xs text-slate-500 font-mono"><%= product.slug %></div>
              </td>
              <td class="py-3 px-4 text-xs text-slate-300"><%= product.category.name %></td>
              <td class="py-3 px-4 text-sm font-bold text-white"><%= number_to_currency(product.price, unit: "¥", precision: 0) %></td>
              <td class="py-3 px-4">
                <%= form_with url: update_stock_admin_product_path(product), method: :patch, class: "flex items-center space-x-1" do |f| %>
                  <%= f.number_field :stock_quantity, value: product.stock_quantity, min: 0, class: "w-16 py-1 px-2 text-xs bg-slate-950 border border-slate-700 rounded-lg text-white font-bold text-center" %>
                  <%= f.submit "更新", class: "px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[10px] font-bold cursor-pointer" %>
                <% end %>
              </td>
              <td class="py-3 px-4">
                <%= button_to toggle_publish_admin_product_path(product), method: :patch, class: "px-2.5 py-1 rounded text-xs font-bold cursor-pointer #{product.is_published? ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-slate-800 text-slate-400'}" do %>
                  <%= product.is_published? ? '公開中' : '非公開' %>
                <% end %>
              </td>
              <td class="py-3 px-4 text-right space-x-2">
                <%= link_to "編集", edit_admin_product_path(product), class: "text-xs font-bold text-indigo-400 hover:text-indigo-300" %>
                <%= button_to "削除", admin_product_path(product), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "text-xs font-bold text-rose-400 hover:text-rose-300 inline-block cursor-pointer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
