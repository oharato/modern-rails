<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">注文履歴</h1>
    <span class="text-xs text-slate-500">全 <%= @orders.size %> 件</span>
  </div>

  <% if @orders.empty? %>
    <div class="bg-white p-12 rounded-3xl border border-slate-200 text-center space-y-4">
      <div class="text-4xl">📦</div>
      <h2 class="text-lg font-bold text-slate-800">注文履歴がありません</h2>
      <p class="text-xs text-slate-500">お気に入りの商品を購入してみましょう！</p>
      <%= link_to "商品一覧へ", products_path, class: "inline-block px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-bold text-xs" %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <div class="bg-white rounded-3xl border border-slate-200/80 p-6 shadow-sm space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-3 border-b border-slate-100 gap-2">
            <div class="flex items-center space-x-3">
              <span class="font-mono font-bold text-sm text-slate-900"><%= order.order_number %></span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= order.status == 'paid' ? 'bg-emerald-100 text-emerald-800' : order.status == 'shipped' ? 'bg-indigo-100 text-indigo-800' : 'bg-slate-100 text-slate-700' %>">
                <%= order.status.upcase %>
              </span>
            </div>
            <div class="text-xs text-slate-400">
              <%= order.created_at.strftime("%Y年%m月%d日 %H:%M") %>
            </div>
          </div>

          <!-- Items in Order -->
          <div class="divide-y divide-slate-50">
            <% order.order_items.each do |item| %>
              <div class="py-2 flex justify-between items-center text-xs">
                <span class="font-semibold text-slate-800"><%= item.product&.name || "商品 ##{item.product_id}" %> &times; <%= item.quantity %></span>
                <span class="font-bold text-slate-900"><%= number_to_currency(item.subtotal, unit: "¥", precision: 0) %></span>
              </div>
            <% end %>
          </div>

          <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="text-sm font-bold text-slate-700">
              合計: <span class="text-lg font-black text-indigo-600"><%= number_to_currency(order.total_amount, unit: "¥", precision: 0) %></span>
            </div>

            <div class="flex items-center space-x-2">
              <%= link_to receipt_order_path(order), target: "_blank", class: "inline-flex items-center px-4 py-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs border border-indigo-200 transition" do %>
                📄 領収書PDF
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
