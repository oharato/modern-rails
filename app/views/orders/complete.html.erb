<div class="max-w-2xl mx-auto text-center space-y-8 py-8">
  <div class="w-20 h-20 mx-auto rounded-3xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-4xl shadow-sm animate-bounce">
    ✓
  </div>

  <div class="space-y-3">
    <h1 class="text-3xl font-black text-slate-900 tracking-tight">ご注文ありがとうございました！</h1>
    <p class="text-sm text-slate-600">注文番号: <strong class="text-indigo-600 font-mono text-base"><%= @order.order_number %></strong></p>
    <p class="text-xs text-slate-500">
      ご注文確認メールを <strong><%= @order.user.email_address %></strong> 宛てに送信いたしました。<br>
      バックグラウンドジョブ（Solid Queue）にて領収書PDFを生成中です。
    </p>
  </div>

  <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm text-left space-y-4">
    <h3 class="font-bold text-sm text-slate-900 border-b border-slate-100 pb-2">注文概要</h3>
    <div class="space-y-2 text-xs text-slate-600">
      <div class="flex justify-between">
        <span>合計金額:</span>
        <span class="font-bold text-slate-900 text-sm"><%= number_to_currency(@order.total_amount, unit: "¥", precision: 0) %></span>
      </div>
      <div class="flex justify-between">
        <span>決済ステータス:</span>
        <span class="px-2 py-0.5 rounded font-bold bg-emerald-100 text-emerald-800 text-[11px]">決済完了 (Paid)</span>
      </div>
      <div class="flex justify-between">
        <span>注文日時:</span>
        <span><%= @order.created_at.strftime("%Y/%m/%d %H:%M") %></span>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap justify-center gap-4">
    <%= link_to receipt_order_path(@order), target: "_blank", class: "inline-flex items-center px-6 py-3 rounded-2xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-sm border border-indigo-200 transition" do %>
      📄 領収書PDFをダウンロード
    <% end %>
    <%= link_to mypage_orders_path, class: "inline-flex items-center px-6 py-3 rounded-2xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-sm transition" do %>
      注文履歴を見る
    <% end %>
    <%= link_to "トップページへ戻る", root_path, class: "inline-flex items-center px-6 py-3 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm border border-slate-200 transition" %>
  </div>
</div>
