<!DOCTYPE html>
<html class="h-full bg-slate-50 text-slate-900">
  <head>
    <title><%= content_for(:title) || "CraftCommerce - モダンクラフトEC" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Turbo 8 Page Refresh morphing -->
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full flex flex-col antialiased font-sans bg-slate-50">
    <!-- Header / Nav -->
    <header class="bg-white/95 backdrop-blur border-b border-slate-200 sticky top-0 z-40 transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <!-- Logo & Brand -->
          <div class="flex items-center space-x-6">
            <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
              <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-600 via-orange-500 to-indigo-600 flex items-center justify-center text-white font-black text-xl shadow-md group-hover:scale-105 transition transform">
                ✨
              </div>
              <div>
                <span class="font-extrabold text-xl text-slate-900 tracking-tight">CraftCommerce</span>
                <span class="text-[10px] block text-slate-400 font-semibold uppercase tracking-wider -mt-1">Rails 8 Edition</span>
              </div>
            <% end %>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center space-x-1">
              <%= link_to "トップ", root_path, class: "px-3 py-2 text-sm font-medium text-slate-700 hover:text-indigo-600 rounded-lg hover:bg-slate-100 transition" %>
              <%= link_to "商品一覧", products_path, class: "px-3 py-2 text-sm font-medium text-slate-700 hover:text-indigo-600 rounded-lg hover:bg-slate-100 transition" %>
            </nav>
          </div>

          <!-- User & Cart Actions -->
          <div class="flex items-center space-x-3 sm:space-x-4">
            <!-- Cart Badge -->
            <%= render "shared/cart_badge" %>

            <% if authenticated? %>
              <%= link_to dashboard_path, class: "text-sm font-medium text-slate-700 hover:text-indigo-600 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition hidden sm:inline-block" do %>
                ダッシュボード
              <% end %>

              <%= link_to mypage_orders_path, class: "text-sm font-medium text-slate-700 hover:text-indigo-600 px-3 py-1.5 rounded-lg hover:bg-slate-100 transition hidden sm:inline-block" do %>
                注文履歴
              <% end %>

              <% if Current.user&.admin? %>
                <%= link_to admin_root_path, class: "text-xs font-bold bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1 rounded-md shadow-sm transition" do %>
                  Admin
                <% end %>
              <% end %>

              <div class="text-xs text-slate-500 hidden lg:block bg-slate-100 px-2.5 py-1 rounded-full">
                <%= Current.user.name.presence || Current.user.email_address %>
              </div>

              <%= button_to "ログアウト", session_path, method: :delete, class: "text-xs text-slate-500 hover:text-rose-600 font-medium px-2 py-1 cursor-pointer" %>
            <% else %>
              <%= link_to "ログイン", login_path, class: "text-sm font-medium text-slate-700 hover:text-indigo-600 px-3 py-1.5" %>
              <%= link_to "新規登録", signup_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-semibold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition hover:shadow" %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0 text-xs text-slate-500">
        <div>
          &copy; <%= Time.current.year %> CraftCommerce. Modern Rails 8 + Solid Trio Benchmark Demo.
        </div>
        <div class="flex space-x-4">
          <%= link_to "トップ", root_path, class: "hover:text-slate-800" %>
          <%= link_to "商品一覧", products_path, class: "hover:text-slate-800" %>
          <%= link_to "カート", cart_path, class: "hover:text-slate-800" %>
          <% if authenticated? && Current.user&.admin? %>
            <%= link_to "管理者画面", admin_root_path, class: "text-amber-600 hover:text-amber-700 font-semibold" %>
          <% end %>
        </div>
      </div>
    </footer>
  </body>
</html>
