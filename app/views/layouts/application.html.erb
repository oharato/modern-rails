<!DOCTYPE html>
<html class="h-full bg-slate-50 text-slate-900">
  <head>
    <title><%= content_for(:title) || "Modern Rails 8 Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Turbo 8 Page Refresh morphing -->
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <!-- LINE Seed JP Font -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/line-seed-jp@latest/css/line-seed-jp.css">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full flex flex-col antialiased">
    <!-- Header / Nav -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
              R8
            </div>
            <%= link_to root_path, class: "font-semibold text-lg text-slate-800 hover:text-indigo-600 transition" do %>
              Modern Rails 8 App
            <% end %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-800">
              Rails 8.0 + Postgres 17 + Hotwire
            </span>
          </div>

          <div class="flex items-center space-x-4">
            <%= link_to "📚 学習ガイド", guide_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg transition" %>
            <% if authenticated? %>
              <div class="text-sm text-slate-600 hidden sm:block">
                <%= Current.user.email_address %>
              </div>
              <%= link_to "ダッシュボード", root_path, class: "text-sm font-medium text-slate-700 hover:text-indigo-600" %>
              <%= link_to "ジョブ実行テスト", jobs_test_path, class: "text-sm font-medium text-slate-700 hover:text-indigo-600" %>
              <%= button_to "ログアウト", session_path, method: :delete, class: "text-sm text-red-600 hover:text-red-700 font-medium cursor-pointer" %>
            <% else %>
              <%= link_to "ログイン", new_session_path, class: "text-sm font-medium text-slate-700 hover:text-indigo-600" %>
              <%= link_to "新規登録", new_registration_path, class: "inline-flex items-center px-3.5 py-1.5 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <% if notice %>
        <div class="mb-6 p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium flex items-center justify-between">
          <span><%= notice %></span>
        </div>
      <% end %>

      <% if alert %>
        <div class="mb-6 p-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium flex items-center justify-between">
          <span><%= alert %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-slate-400">
        Built with Ruby 4.0, Rails 8, PostgreSQL 17, Solid Queue/Cache/Cable, and Tailwind CSS v4.
      </div>
    </footer>
  </body>
</html>
