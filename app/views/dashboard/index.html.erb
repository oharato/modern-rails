<div class="space-y-8">
  <!-- Top Welcome & Stats Cards (Cached with Solid Cache) -->
  <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-5">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">ダッシュボード</h1>
        <p class="text-sm text-slate-500 mt-0.5">Rails 8 + Solid Cache / Solid Queue / Hotwire Turbo 実践環境</p>
      </div>
      <div class="flex items-center gap-3">
        <%= button_to "ジョブで集計更新 (Solid Queue)", trigger_jobs_path, method: :post, class: "inline-flex items-center gap-2 px-4 py-2 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-lg text-sm font-medium transition cursor-pointer" %>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-5">
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-100">
        <div class="text-xs font-medium text-slate-500">プロジェクト数</div>
        <div class="text-2xl font-bold text-slate-800 mt-1"><%= @stats[:total_projects] %></div>
      </div>
      <div class="p-4 bg-slate-50 rounded-xl border border-slate-100">
        <div class="text-xs font-medium text-slate-500">総タスク数</div>
        <div class="text-2xl font-bold text-slate-800 mt-1"><%= @stats[:total_tasks] %></div>
      </div>
      <div class="p-4 bg-amber-50/60 rounded-xl border border-amber-100">
        <div class="text-xs font-medium text-amber-700">未完了タスク</div>
        <div class="text-2xl font-bold text-amber-900 mt-1"><%= @stats[:pending_tasks] %></div>
      </div>
      <div class="p-4 bg-emerald-50/60 rounded-xl border border-emerald-100">
        <div class="text-xs font-medium text-emerald-700">完了タスク</div>
        <div class="text-2xl font-bold text-emerald-900 mt-1"><%= @stats[:completed_tasks] %></div>
      </div>
    </div>
    <div class="mt-3 text-right">
      <span class="text-xs text-slate-400">
        Solid Cache キャッシュ日時: <%= @stats[:cached_at]&.strftime("%H:%M:%S") %>
        <% if @stats[:job_processed_at] %>
          (ジョブ処理: <%= @stats[:job_processed_at]&.strftime("%H:%M:%S") %>)
        <% end %>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column: Projects -->
    <div class="space-y-6">
      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
        <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center justify-between">
          <span>プロジェクト</span>
          <span class="text-xs font-normal text-slate-400">Turbo Streams 自動更新</span>
        </h2>

        <!-- New Project Form -->
        <div class="mb-6">
          <%= render "projects/form", project: @new_project %>
        </div>

        <!-- Project List -->
        <div id="projects_list" class="space-y-2">
          <% if @projects.any? %>
            <%= render @projects %>
          <% else %>
            <p id="no_projects_msg" class="text-sm text-slate-400 py-4 text-center">プロジェクトはまだありません</p>
          <% end %>
        </div>
      </div>

      <!-- Rails 8 Tech Stack Guide Card -->
      <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-5 rounded-2xl shadow-sm">
        <h3 class="text-base font-semibold text-indigo-200">Rails 8 注目スタック</h3>
        <ul class="mt-3 space-y-2 text-xs text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span><strong>Authentication</strong>: 標準ジェネレータで自前認証</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span><strong>Solid Trio</strong>: Queue / Cache / Cable をPostgresで完結</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span><strong>Tailwind CSS v4</strong>: 高速なCSSコンパイル (tailwindcss-rails)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span><strong>Propshaft + Importmap</strong>: Node.jsレスな高速アセット配信</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span><strong>Kamal 2</strong>: Dockerベースのシンプル・堅牢なデプロイ</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Right Column: Tasks -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
        <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center justify-between">
          <span>タスク一覧</span>
          <span class="text-xs font-normal text-slate-400">Turbo Streams で即時反映</span>
        </h2>

        <!-- New Task Form -->
        <div class="mb-6 bg-slate-50/70 p-4 rounded-xl border border-slate-200">
          <%= render "tasks/form", task: @new_task, projects: @projects %>
        </div>

        <!-- Task List -->
        <div id="tasks_list" class="divide-y divide-slate-100">
          <% if @tasks.any? %>
            <%= render @tasks %>
          <% else %>
            <p id="no_tasks_msg" class="text-sm text-slate-400 py-8 text-center">タスクはまだありません。上のフォームから追加してください。</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
