<%= form_with model: project, id: "project_form", class: "space-y-3" do |f| %>
  <div class="flex gap-2">
    <%= f.text_field :title, placeholder: "新規プロジェクト名...", required: true, class: "flex-1 rounded-lg border-slate-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border" %>
    <%= f.select :color, [["Blue", "blue"], ["Green", "green"], ["Purple", "purple"], ["Amber", "amber"], ["Rose", "rose"]], {}, class: "rounded-lg border-slate-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-2 border bg-white" %>
    <%= f.submit "追加", class: "px-3 py-2 bg-slate-800 text-white rounded-lg text-sm font-medium hover:bg-slate-700 transition cursor-pointer" %>
  </div>
<% end %>
