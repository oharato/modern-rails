<div id="<%= dom_id(project) %>" class="flex items-center justify-between p-2.5 rounded-lg border border-slate-100 hover:bg-slate-50 transition group">
  <div class="flex items-center gap-2.5 min-w-0">
    <span class="w-3 h-3 rounded-full shrink-0 <%= 
      case project.color
      when 'blue' then 'bg-blue-500'
      when 'green' then 'bg-emerald-500'
      when 'purple' then 'bg-purple-500'
      when 'amber' then 'bg-amber-500'
      when 'rose' then 'bg-rose-500'
      else 'bg-indigo-500'
      end
    %>"></span>
    <span class="text-sm font-medium text-slate-700 truncate"><%= project.title %></span>
    <span class="text-xs text-slate-400 shrink-0">(<%= project.tasks.count %>)</span>
  </div>
  <%= button_to project_path(project), method: :delete, data: { turbo_confirm: "プロジェクト「#{project.title}」を削除しますか？" }, class: "text-slate-300 hover:text-rose-600 transition p-1 text-xs opacity-0 group-hover:opacity-100 cursor-pointer" do %>
    ✕
  <% end %>
</div>
