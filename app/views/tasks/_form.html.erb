<%= form_with model: task, id: "task_form", class: "space-y-3" do |f| %>
  <div class="flex flex-col sm:flex-row gap-2">
    <%= f.text_field :title, placeholder: "新しいタスクを入力...", required: true, class: "flex-1 rounded-lg border-slate-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500 px-3 py-2 border bg-white" %>
    <div class="flex gap-2">
      <%= f.collection_select :project_id, Current.user.projects, :id, :title, { prompt: "プロジェクトなし" }, class: "rounded-lg border-slate-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-2 border bg-white text-slate-700" %>
      <%= f.select :priority, Task.priorities.keys.map { |k| [k.capitalize, k] }, {}, class: "rounded-lg border-slate-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-2 border bg-white text-slate-700" %>
      <%= f.submit "追加", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 transition cursor-pointer shadow-sm" %>
    </div>
  </div>
<% end %>
