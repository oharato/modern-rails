<div class="group bg-white rounded-2xl border border-slate-200/80 hover:border-indigo-300 overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 flex flex-col">
  <%= link_to product_path(product.slug), class: "block relative aspect-square bg-slate-100 overflow-hidden" do %>
    <%= product_image_tag(product, extra_class: "w-full h-full object-cover group-hover:scale-105 transition duration-300") %>
    <div class="absolute top-2.5 left-2.5">
      <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-white/90 backdrop-blur text-slate-700 shadow-sm">
        <%= product.category&.name %>
      </span>
    </div>
  <% end %>

  <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
    <div>
      <div class="flex items-center justify-between mb-1">
        <%= render "products/stock_badge", product: product %>
        <% if product.rating_count > 0 %>
          <span class="text-xs font-medium text-amber-700 flex items-center">
            ★ <%= product.average_rating %> <span class="text-slate-600 text-[10px] ml-0.5">(<%= product.rating_count %>)</span>
          </span>
        <% end %>
      </div>
      <%= link_to product_path(product.slug), class: "block font-bold text-slate-900 group-hover:text-indigo-600 transition line-clamp-1 text-base" do %>
        <%= product.name %>
      <% end %>
      <p class="text-xs text-slate-600 line-clamp-2 mt-1"><%= product.description %></p>
    </div>

    <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
      <div class="text-lg font-black text-slate-900">
        <%= number_to_currency(product.price, unit: "¥", precision: 0) %>
      </div>
      <% if product.in_stock? %>
        <%= button_to add_item_cart_path(product_id: product.id), method: :post, aria: { label: "#{product.name}をカートに追加" }, class: "inline-flex items-center justify-center p-2 rounded-xl bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white transition cursor-pointer group-btn" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        <% end %>
      <% else %>
        <span class="text-xs font-medium text-slate-500">売切</span>
      <% end %>
    </div>
  </div>
</div>
