<div class="space-y-8">
  <!-- Header & Filters -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        <%= @current_category ? @current_category.name : "すべての商品" %>
      </h1>
      <p class="text-xs text-slate-500 mt-1">
        全 <%= @products.size %> 件の商品 &middot; Solid Cache 60秒キャッシュ配信
      </p>
    </div>

    <!-- Search Form -->
    <div class="flex items-center gap-3">
      <%= form_with url: products_path, method: :get, class: "flex items-center gap-2" do |f| %>
        <% if @category_slug.present? %>
          <%= f.hidden_field :category, value: @category_slug %>
        <% end %>
        <div class="relative">
          <%= f.text_field :query, value: @query, placeholder: "キーワード検索...", class: "w-48 sm:w-64 pl-9 pr-4 py-2 text-sm rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white" %>
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <%= f.submit "検索", class: "px-4 py-2 bg-slate-800 text-white rounded-xl text-sm font-semibold hover:bg-slate-900 cursor-pointer transition" %>
      <% end %>
    </div>
  </div>

  <!-- Category Filter Pills -->
  <div class="flex flex-wrap gap-2 pb-2 border-b border-slate-200">
    <%= link_to "すべて", products_path(query: @query), class: "px-4 py-1.5 rounded-full text-xs font-bold transition #{@category_slug.blank? ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}" %>
    <% @categories.each do |cat| %>
      <%= link_to cat.name, category_products_path(cat.slug, query: @query), class: "px-4 py-1.5 rounded-full text-xs font-bold transition #{@category_slug == cat.slug ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}" %>
    <% end %>
  </div>

  <!-- Products Grid -->
  <% if @products.empty? %>
    <div class="py-16 text-center bg-white rounded-3xl border border-slate-200 space-y-3">
      <div class="text-4xl">🔍</div>
      <h3 class="text-base font-bold text-slate-800">商品が見つかりませんでした</h3>
      <p class="text-xs text-slate-500">検索条件を変更してお試しください。</p>
      <%= link_to "全商品を見る", products_path, class: "inline-block px-4 py-2 text-xs font-bold bg-indigo-50 text-indigo-600 rounded-xl hover:bg-indigo-100 transition" %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% @products.each do |product| %>
        <%= render "products/product_card", product: product %>
      <% end %>
    </div>
  <% end %>
</div>
