<div class="space-y-12">
  <!-- Hero Featured Banner -->
  <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white shadow-xl p-8 sm:p-12 lg:p-16">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-500/20 via-purple-500/10 to-transparent"></div>
    <div class="relative max-w-2xl space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-indigo-500/30 border border-indigo-400/30 text-indigo-200 text-xs font-semibold">
        <span>✨ Modern Rails 8 + Solid Trio Architecture</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
        厳選されたクラフトと、<br><span class="bg-gradient-to-r from-amber-300 via-orange-300 to-indigo-200 bg-clip-text text-transparent">ミリ秒の高速体験。</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Solid Cache による超高速カタログ配信、KV Store によるカート管理、Solid Queue &amp; Cable による非同期・リアルタイム在庫同期。Rails 8 の進化を体感するECプラットフォーム。
      </p>
      <div class="flex flex-wrap gap-4 pt-2">
        <%= link_to products_path, class: "inline-flex items-center px-6 py-3 rounded-2xl bg-white text-slate-900 font-bold hover:bg-slate-100 shadow-md transition transform hover:-translate-y-0.5" do %>
          商品一覧を見る
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        <% end %>
        <%= link_to "/guide", class: "inline-flex items-center px-6 py-3 rounded-2xl bg-slate-800/80 hover:bg-slate-800 text-slate-200 font-semibold border border-slate-700 transition" do %>
          アーキテクチャ解説
        <% end %>
      </div>
    </div>
  </div>

  <!-- Categories Grid -->
  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">カテゴリから探す</h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-4">
      <% @categories.each do |cat| %>
        <%= link_to category_products_path(cat.slug), class: "group p-4 bg-white rounded-2xl border border-slate-200/80 hover:border-indigo-400 hover:shadow-md transition text-center space-y-2" do %>
          <div class="w-12 h-12 mx-auto rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl group-hover:scale-110 transition transform">
            <%= category_icon(cat.slug) %>
          </div>
          <div class="font-bold text-sm text-slate-800 group-hover:text-indigo-600 transition"><%= cat.name %></div>
          <div class="text-[11px] text-slate-600 line-clamp-1"><%= cat.description %></div>
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">おすすめ商品</h2>
        <p class="text-xs text-slate-500">Solid Cache (60s) による高速SSR配信</p>
      </div>
      <%= link_to "すべて見る &rarr;".html_safe, products_path, class: "text-sm font-bold text-indigo-600 hover:text-indigo-700" %>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      <% @featured_products.each do |product| %>
        <%= render "products/product_card", product: product %>
      <% end %>
    </div>
  </section>

  <!-- Recent Products -->
  <section class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">新着クラフト</h2>
        <p class="text-xs text-slate-500">こだわりの新作アイテム</p>
      </div>
      <%= link_to "すべて見る &rarr;".html_safe, products_path, class: "text-sm font-bold text-indigo-600 hover:text-indigo-700" %>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
      <% @recent_products.each do |product| %>
        <%= render "products/product_card", product: product %>
      <% end %>
    </div>
  </section>

  <!-- Recently Viewed Products (KV Store) -->
  <% if @recently_viewed_products.present? %>
    <section class="space-y-4 pt-4 border-t border-slate-200">
      <div class="flex items-center space-x-2">
        <span class="text-lg">👀</span>
        <div>
          <h2 class="text-lg font-black text-slate-900 tracking-tight">最近チェックした商品</h2>
          <p class="text-[11px] text-slate-500">KV Store (`Solid Cache`) で保持されるユーザー閲覧履歴（直近6件）</p>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
        <% @recently_viewed_products.each do |product| %>
          <%= render "products/product_card", product: product %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
