<div class="max-w-md mx-auto space-y-6 py-6">
  <div class="text-center space-y-2">
    <h1 class="text-2xl font-black text-slate-900 tracking-tight">新規会員登録</h1>
    <p class="text-xs text-slate-500">登録するとゲストカート内の商品は自動で引き継がれます。</p>
  </div>

  <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
    <%= form_with model: @user, url: registration_path, class: "space-y-4" do |f| %>
      <% if @user.errors.any? %>
        <div class="p-3 bg-rose-50 border border-rose-200 rounded-xl text-rose-800 text-xs">
          <%= @user.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "お名前", class: "block text-xs font-bold text-slate-700 mb-1" %>
        <%= f.text_field :name, autofocus: true, placeholder: "クラフト 太郎", class: "w-full p-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 bg-white" %>
      </div>

      <div>
        <%= f.label :email_address, "メールアドレス", class: "block text-xs font-bold text-slate-700 mb-1" %>
        <%= f.email_field :email_address, required: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full p-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 bg-white" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "block text-xs font-bold text-slate-700 mb-1" %>
        <%= f.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••", class: "w-full p-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 bg-white" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "パスワード（確認）", class: "block text-xs font-bold text-slate-700 mb-1" %>
        <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "••••••••", class: "w-full p-3 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-indigo-500 bg-white" %>
      </div>

      <%= f.submit "アカウント作成", class: "w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold text-sm shadow-md transition cursor-pointer" %>
    <% end %>
  </div>

  <div class="text-center text-xs text-slate-500">
    すでにアカウントをお持ちですか？ <%= link_to "ログイン", login_path, class: "text-indigo-600 font-bold hover:underline" %>
  </div>
</div>
