<span id="cart_nav_badge" class="relative inline-flex items-center">
  <% count = current_cart.total_count %>
  <%= link_to cart_path, aria: { label: "ショッピングカート (#{count}点)" }, class: "relative p-2 text-slate-700 hover:text-indigo-600 transition flex items-center" do %>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>
    <% count = current_cart.total_count %>
    <% if count > 0 %>
      <span class="absolute -top-1 -right-1 bg-rose-500 text-white font-bold text-xs w-5 h-5 rounded-full flex items-center justify-center shadow-sm">
        <%= count %>
      </span>
    <% end %>
    <span class="ml-1 text-sm font-medium hidden sm:inline">カート</span>
  <% end %>
</span>
