<div class="max-w-4xl mx-auto space-y-12 py-4">
  <!-- Hero -->
  <div class="text-center space-y-4">
    <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-indigo-100 text-indigo-800 border border-indigo-200">
      Architecture Deep Dive
    </span>
    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
      Modern Rails 8 vs NuxtHub<br>
      <span class="bg-gradient-to-r from-indigo-600 to-amber-600 bg-clip-text text-transparent">「CraftCommerce」設計・比較検証</span>
    </h1>
    <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
      画像配信、高速キャッシュ、KVカート、トランザクション、非同期ジョブ、リアルタイム在庫同期など、
      Web開発におけるあらゆる技術要素が詰まったECプラットフォームの実装ガイド。
    </p>
  </div>

  <!-- Tech Stack Mapping Table -->
  <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm space-y-4 p-6 sm:p-8">
    <h2 class="text-xl font-extrabold text-slate-900 border-b border-slate-100 pb-3">技術スタック対照表</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left">
        <thead class="bg-slate-50 font-bold text-slate-700 uppercase">
          <tr>
            <th class="py-3 px-4 rounded-l-xl">機能コンポーネント</th>
            <th class="py-3 px-4">ECユースケース</th>
            <th class="py-3 px-4 bg-indigo-50/50 text-indigo-900 font-black">Modern Rails (Rails 8)</th>
            <th class="py-3 px-4 bg-emerald-50/50 text-emerald-900 font-black rounded-r-xl">NuxtHub (Nuxt 4 + CF)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">カタログ / SSR</td>
            <td class="py-3 px-4 text-slate-600">SEO & 高速レンダリング</td>
            <td class="py-3 px-4 font-semibold text-indigo-700">Hotwire (Turbo + Morphing)</td>
            <td class="py-3 px-4 font-semibold text-emerald-700">Vue 3 + Nuxt 4 SSR</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">データ & 注文</td>
            <td class="py-3 px-4 text-slate-600">ユーザー、在庫、トランザクション</td>
            <td class="py-3 px-4 font-semibold text-indigo-700">SQLite3 + ActiveRecord</td>
            <td class="py-3 px-4 font-semibold text-emerald-700">Cloudflare D1 + Drizzle ORM</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">カート & 閲覧履歴</td>
            <td class="py-3 px-4 text-slate-600">高速一時保持、自動マージ</td>
            <td class="py-3 px-4 font-semibold text-indigo-700">Solid Cache (KV Store)</td>
            <td class="py-3 px-4 font-semibold text-emerald-700">Cloudflare KV (hubKV)</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">画像 & 領収書PDF</td>
            <td class="py-3 px-4 text-slate-600">ギャラリー画像、PDF帳票保管</td>
            <td class="py-3 px-4 font-semibold text-indigo-700">Active Storage + Prawn</td>
            <td class="py-3 px-4 font-semibold text-emerald-700">Cloudflare R2 + pdf-lib</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">非同期処理</td>
            <td class="py-3 px-4 text-slate-600">注文完了メール、PDF生成、集計バッチ</td>
            <td class="py-3 px-4 font-semibold text-indigo-700">Solid Queue + Active Job</td>
            <td class="py-3 px-4 font-semibold text-emerald-700">Cloudflare Queues / Nitro Tasks</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">カタログキャッシュ</td>
            <td class="py-3 px-4 text-slate-600">トップ・一覧の60sキャッシュ</td>
            <td class="py-3 px-4 font-semibold text-indigo-700">Solid Cache (Rails.cache)</td>
            <td class="py-3 px-4 font-semibold text-emerald-700">Nitro Cache (defineCachedEventHandler)</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">在庫ライブ同期</td>
            <td class="py-3 px-4 text-slate-600">残り在庫数のリアルタイム更新</td>
            <td class="py-3 px-4 font-semibold text-indigo-700">Solid Cable + Turbo Streams</td>
            <td class="py-3 px-4 font-semibold text-emerald-700">Server-Sent Events (SSE)</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">認証 & 権限</td>
            <td class="py-3 px-4 text-slate-600">顧客アカウント & Admin</td>
            <td class="py-3 px-4 font-semibold text-indigo-700">Rails 8 組み込み認証 + Role</td>
            <td class="py-3 px-4 font-semibold text-emerald-700">暗号化 Cookie (h3 sealSession)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Key Architecture Features -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-3xl border border-slate-200 space-y-3">
      <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
        ⚡
      </div>
      <h3 class="font-bold text-base text-slate-900">Solid Cache による一時カート & KV</h3>
      <p class="text-xs text-slate-600 leading-relaxed">
        未ログイン（ゲスト）時は Cookie の UUID に紐づく <code>cart:guest_&lt;uuid&gt;</code>（TTL: 7日）、ログイン時は <code>cart:user_&lt;id&gt;</code>（TTL: 30日）として Solid Cache の Key-Value ストアで超高速に読み書きします。ログイン時に自動で統合（マージ）されます。
      </p>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-200 space-y-3">
      <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
        🔒
      </div>
      <h3 class="font-bold text-base text-slate-900">排他ロックとトランザクション整合性</h3>
      <p class="text-xs text-slate-600 leading-relaxed">
        チェックアウト時には <code>Product.lock</code> による悲観的排他ロックとデータベーストランザクションを用いて、在庫数を安全に引き当てます。在庫不足時はロールバックし二重購入を防止します。
      </p>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-200 space-y-3">
      <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
        📡
      </div>
      <h3 class="font-bold text-base text-slate-900">Solid Cable リアルタイム同期</h3>
      <p class="text-xs text-slate-600 leading-relaxed">
        Redis などの外部サーバー不要で、SQLite バックエンドの Solid Cable を通じて WebSocket 配信。商品詳細画面を開いている他ユーザーの在庫バッジを即座に更新し、管理者画面へ注文速報トーストを通知します。
      </p>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-200 space-y-3">
      <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl font-bold">
        📄
      </div>
      <h3 class="font-bold text-base text-slate-900">Solid Queue 非同期PDF・メール処理</h3>
      <p class="text-xs text-slate-600 leading-relaxed">
        注文確定後、Prawn による領収書PDF生成ジョブと注文確認メール送信ジョブが非同期で実行され、生成された PDF は Active Storage に永続化されます。ジョブの実行状況は <code>JobLog</code> テーブルに記録されます。
      </p>
    </div>
  </div>

  <div class="text-center pt-4">
    <%= link_to "&larr; ショップへ戻る".html_safe, root_path, class: "inline-flex items-center px-6 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-md transition" %>
  </div>
</div>
